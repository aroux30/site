"""Negative test for check_media_routes_reachable.

This gate exists because a bad edit truncated `media/api/routes.py` to seven
lines and the whole app stopped booting — `main.py` raises on a router that
fails to import, so nothing was reachable at all, not even the routes that were
fine. Nothing caught it until a fixture happened to import the app.

So the sabotage is the one that happened, and the gate has to go red on it:

  A. Delete one media route. Nine were missing after the rebuild before this
     gate existed, and every one of them was a path the frontend calls — the
     library's move action, its crop button, its usage warning, its
     empty-trash action.
  B. Guard the routes with a codename that is not in the RBAC seed. Every
     request then 403s, with a message naming a permission the operator cannot
     grant.

Run:  python scripts/wp-parity/negative_test_media_routes_reachable.py
"""

from __future__ import annotations

import os
import re
import subprocess
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
ROOT = os.path.dirname(os.path.dirname(HERE))
GATE = os.path.join(HERE, "check_media_routes_reachable.py")
ROUTES = os.path.join(ROOT, "backend", "app", "modules", "media", "api", "routes.py")

_NL = chr(10)

#: A route the frontend calls and that has no other copy in the file, so the
#: removal is unambiguous. `/media/move` is one of the nine that went missing.
#:
#: Built from chr(10) rather than a triple-quoted pattern on purpose: an escape
#: sequence inside a bash heredoc turns `\n` into a real newline and the regex
#: stops compiling, which is the same class of mistake as the one this whole
#: script guards against.
MOVE_ROUTE_RE = re.compile(
    "@router" + r"\.post\(" + _NL + r'    "/move",'
    + r".*?return \{\"moved\": moved\}" + _NL,
    re.S,
)

WRITE_GUARD = '_require_media_write = Depends(RequirePermissions("media:write"))'
BAD_GUARD = '_require_media_write = Depends(RequirePermissions("media:delete"))'

#: The `GET /trash` block as it appears in the file, so sabotage C can move it.
GET_TRASH_BLOCK = (
    '@router.get(' + _NL
    + '    "/trash",' + _NL
    + "    response_model=MediaTrashListResponse," + _NL
    + '    summary="List trashed assets (admin)",' + _NL
    + "    dependencies=[_require_media_read]," + _NL
    + ")" + _NL
    + "async def list_media_trash(" + _NL
    + "    page: int = Query(1, ge=1)," + _NL
    + "    page_size: int = Query(20, ge=1, le=100)," + _NL
    + "    db: AsyncSession = Depends(get_db)," + _NL
    + ") -> MediaTrashListResponse:" + _NL
    + "    items, total = await MediaService.list_trashed(" + _NL
    + "        db, page=page, page_size=page_size" + _NL
    + "    )" + _NL
    + "    return MediaTrashListResponse(" + _NL
    + "        items=[await _asset_response(db, a) for a in items]," + _NL
    + "        total=total," + _NL
    + "        page=page," + _NL
    + "        page_size=page_size," + _NL
    + "        total_pages=max(1, math.ceil(total / page_size)) if total else 0," + _NL
    + "    )"
)

#: The `GET /{asset_id}` route that used to sit before the trash block.
GET_ASSET_BLOCK = (
    '@router.get(' + _NL
    + '    "/{asset_id}",' + _NL
    + "    response_model=MediaAssetResponse," + _NL
    + '    summary="Get one media asset",' + _NL
    + "    dependencies=[_require_media_read]," + _NL
    + ")" + _NL
    + "async def get_media_asset(" + _NL
    + "    asset_id: uuid.UUID," + _NL
    + "    db: AsyncSession = Depends(get_db)," + _NL
    + ") -> MediaAssetResponse:" + _NL
    + "    asset = await MediaService.get_asset(db, asset_id)" + _NL
    + "    return await _asset_response(db, asset)"
)

#: The purge route, for sabotage D.
PURGE_BLOCK = (
    '@router.delete(' + _NL
    + '    "/trash/{asset_id}",' + _NL
    + '    summary="Permanently delete one trashed asset (admin)",' + _NL
    + "    dependencies=[_require_media_write]," + _NL
    + ")" + _NL
    + "async def purge_media_asset(" + _NL
    + "    asset_id: uuid.UUID," + _NL
    + "    db: AsyncSession = Depends(get_db)," + _NL
    + ") -> dict[str, Any]:"
)


def _shadow_get_trash(src: str) -> str:
    """Move `GET /trash` to after `GET /{asset_id}` — the 422 bug."""
    if GET_TRASH_BLOCK not in src or GET_ASSET_BLOCK not in src:
        return src
    return src.replace(GET_TRASH_BLOCK, "", 1).replace(
        GET_ASSET_BLOCK, GET_ASSET_BLOCK + _NL + _NL + GET_TRASH_BLOCK, 1
    )


def _drop_delete_trash(src: str) -> str:
    """Remove the purge route — the 405 bug."""
    if PURGE_BLOCK not in src:
        return src
    return src.replace(PURGE_BLOCK, "", 1)


def run_gate() -> tuple[int, str]:
    proc = subprocess.run(
        [sys.executable, GATE], capture_output=True, text=True,
        encoding="utf-8", errors="replace", timeout=600,
    )
    return proc.returncode, (proc.stdout or "") + (proc.stderr or "")


def main() -> int:
    with open(ROUTES, encoding="utf-8") as fh:
        original = fh.read()

    rc, out = run_gate()
    if rc != 0:
        print("FAIL: the gate does not pass on the real code, so a failure "
              "below would prove nothing.")
        print(out.strip()[-900:])
        return 1
    print("gate passes on the real code")

    ok = True
    for label, changed in (
        ("A: delete the /media/move route", MOVE_ROUTE_RE.sub("", original, count=1)),
        ("B: guard the routes with a codename outside the RBAC seed",
         original.replace(WRITE_GUARD, BAD_GUARD, 1)),
        # C reproduces the exact bug the gate missed: `/trash` declared after
        # `GET /{asset_id}`. Path-only comparison saw "the path exists" and
        # passed while every trash request 422'd.
        ("C: move GET /trash after GET /{asset_id} (shadowed literal)",
         _shadow_get_trash(original)),
        # D reproduces the other half: the client calls
        # `DELETE /media/trash/{id}` and no such route existed (405).
        ("D: delete the DELETE /media/trash/{id} purge route",
         _drop_delete_trash(original)),
    ):
        if changed == original:
            print(f"FAIL: {label} — nothing changed, so the gate was tested "
                  f"against a no-op.")
            ok = False
            continue

        with open(ROUTES, "w", encoding="utf-8", newline="") as fh:
            fh.write(changed)
        try:
            rc_broken, out_broken = run_gate()
        finally:
            with open(ROUTES, "w", encoding="utf-8", newline="") as fh:
                fh.write(original)

        rc_after, _ = run_gate()
        if rc_after != 0:
            print(f"FAIL: {label} — the gate did not pass again after restoring.")
            ok = False
            continue
        if rc_broken == 0:
            print(f"FAIL: {label} still passed. The gate cannot see it.")
            ok = False
            continue

        caught = [ln.strip() for ln in out_broken.splitlines()
                  if ln.strip().startswith("- ") or "shadowed by" in ln]
        print(f"  {label} -> caught")
        for line in caught[:2]:
            print(f"      {line[:150]}")

    if not ok:
        return 1
    print("\nPASS: the gate goes red on a missing route, on a guard whose "
          "codename nobody can grant, on a shadowed literal route, and on a "
          "client call whose method has no route.")
    return 0


if __name__ == "__main__":
    sys.exit(main())