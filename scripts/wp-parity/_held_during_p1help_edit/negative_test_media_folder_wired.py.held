"""Negative test for check_media_folder_wired.

The disconnect this guards is the one that produced the original gap: a
folder API that works and a library with no button. The sabotages are the three
plausible simplifications, plus one that is invisible in the running app.

  A. Delete the button. The endpoints stay; the feature is unreachable, which
     is the state this feature shipped in.
  B. Delete the "already exists" branch, so the toast says "created" for a
     folder that was not. Nothing errors — the operator is told something false
     about a folder they were making.
  C. Remove the Enter handler. A modal with a button and no Enter gets its
     button double-clicked, which is why B matters.
  D. Drop the query invalidation. The folder is created and the tree does not
     show it, so the button looks broken on first use.

Run:  python scripts/wp-parity/negative_test_media_folder_wired.py
"""

from __future__ import annotations

import os
import re
import subprocess
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
ROOT = os.path.dirname(os.path.dirname(HERE))
GATE = os.path.join(HERE, "check_media_folder_wired.py")
PAGE = os.path.join(ROOT, "frontend", "app", "admin", "media", "page.tsx")

BUTTON_RE = re.compile(
    r"[ \t]*<Button\r?\n[ \t]*variant=\"outline\"\r?\n[ \t]*size=\"sm\"\r?\n"
    r"[ \t]*onClick=\{\(\) => setNewFolderOpen\(true\)\}\r?\n[ \t]*>\r?\n.*?\n[ \t]*</Button>\r?\n",
    re.S,
)
EXISTS_BRANCH = """    if (res.data.created) {
      toast({ title: "پوشه ساخته شد" });
    } else {
      // Creating something that already exists is a double-click, not a
      // fault. Saying so keeps the operator from retrying a button that works.
      toast({ title: "این پوشه از قبل وجود دارد" });
    }
"""


def run_gate() -> tuple[int, str]:
    proc = subprocess.run(
        [sys.executable, GATE], capture_output=True, text=True,
        encoding="utf-8", errors="replace", timeout=300,
    )
    return proc.returncode, (proc.stdout or "") + (proc.stderr or "")


def edit(label: str, fn) -> bool:
    with open(PAGE, encoding="utf-8", newline="") as fh:
        on_disk = fh.read()
    crlf = "\r\n" in on_disk
    original = on_disk.replace("\r\n", "\n")

    def write(text: str) -> None:
        payload = text.replace("\n", "\r\n") if crlf else text
        with open(PAGE, "w", encoding="utf-8", newline="") as fh:
            fh.write(payload)

    try:
        try:
            changed = fn(original)
        except AssertionError as exc:
            print(f"FAIL: {label} — {exc}")
            return False
        if changed == original:
            print(f"FAIL: {label} — nothing changed, so the gate was tested "
                  f"against a no-op.")
            return False
        write(changed)
        try:
            rc, out = run_gate()
        finally:
            write(original)
        rc_after, _ = run_gate()
        if rc_after != 0:
            print(f"FAIL: {label} — the gate did not pass again after restoring.")
            return False
        if rc == 0:
            print(f"FAIL: {label} still passed. The gate cannot see it.")
            return False
        caught = [ln.strip() for ln in out.splitlines() if ln.strip().startswith("- ")]
        print(f"  {label} -> caught")
        for line in caught[:2]:
            print(f"      {line[:150]}")
        return True
    finally:
        write(original)


def main() -> int:
    rc, out = run_gate()
    if rc != 0:
        print("FAIL: the gate does not pass on the real code.")
        print(out.strip()[-700:])
        return 1
    print("gate passes on the real code")

    def drop_button(text: str) -> str:
        new, n = BUTTON_RE.subn("", text, count=1)
        if n != 1:
            raise AssertionError(f"button matched {n} times")
        return new

    def drop_exists_branch(text: str) -> str:
        # Always report success. Nothing errors and the folder really is
        # there — the operator is simply told it was just created.
        if EXISTS_BRANCH not in text:
            raise AssertionError("the created/exists branch is not in the "
                                 "expected shape")
        return text.replace(
            EXISTS_BRANCH,
            '    toast({ title: "پوشه ساخته شد" });\n',
            1)

    def drop_enter(text: str) -> str:
        if 'e.key === "Enter"' not in text:
            raise AssertionError("no Enter handler to remove")
        return text.replace('e.key === "Enter"', 'e.key === "Escape"', 1)

    def drop_invalidation(text: str) -> str:
        # Scoped to the handler: the same line appears in a dozen other
        # mutations on this page, so a bare replace would strip the first one
        # it finds and leave this handler intact — the sabotage would report
        # success having changed nothing relevant.
        start = text.find("const handleCreateFolder = async () => {")
        if start == -1:
            raise AssertionError("the create handler is not in the file")
        end = text.find("\n  };", start)
        body = text[start:end]
        needle = "invalidateKeys: [[MEDIA_QUERY_KEY]],"
        if needle not in body:
            raise AssertionError("no invalidation inside the create handler")
        return text[:start] + body.replace(needle, "", 1) + text[end:]

    ok = True
    for label, fn in (
        ("A: delete the create-folder button", drop_button),
        ("B: always report the folder as created", drop_exists_branch),
        ("C: remove the Enter handler", drop_enter),
        ("D: drop the query invalidation", drop_invalidation),
    ):
        ok = edit(label, fn) and ok

    if not ok:
        return 1
    print("\nPASS: the gate goes red on every way the button stops working.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
