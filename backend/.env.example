# ==============================================================================
# Iranian E-Commerce Platform – Environment Variables
# ==============================================================================
# Copy this file to `.env` and fill in production values.
# DO NOT commit the `.env` file to version control.
# ==============================================================================

# ── Application ──────────────────────────────────────────────────────────
APP_NAME="Iranian E-Commerce"
ENVIRONMENT=development          # development | staging | production
DEBUG=true
LOG_LEVEL=INFO

# ── Database (PostgreSQL) ────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ecommerce
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_ECHO=false

# ── Redis ────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=ecom:
REDIS_DEFAULT_TTL=300

# ── Elasticsearch ────────────────────────────────────────────────────────
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX_PREFIX=ecom_

# ── JWT / Authentication ─────────────────────────────────────────────────
JWT_SECRET_KEY=CHANGE-ME-use-openssl-rand-hex-64
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ─────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Sentry ───────────────────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ── MinIO / S3-compatible storage ────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=ecommerce
MINIO_USE_SSL=false
MINIO_REGION=us-east-1

# ── SMS Provider ─────────────────────────────────────────────────────────
SMS_PROVIDER=mock                # kavenegar | ghasedak | mock
SMS_API_KEY=
SMS_SENDER_NUMBER=

# ── Payment Provider ────────────────────────────────────────────────────
PAYMENT_PROVIDER=mock            # zarinpal | idpay | mock | crypto | card_transfer
PAYMENT_MERCHANT_ID=
PAYMENT_CALLBACK_BASE_URL=http://localhost:3000/payment/callback
PAYMENT_SANDBOX=true
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_SANDBOX=true
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_IRR_PER_USD=600000
CARD_TO_CARD_NUMBER=6219-8610-1234-5678
CARD_TO_CARD_HOLDER=فروشگاه آنلاین
CARD_TO_CARD_BANK=بانک سامان

# ── OTP ──────────────────────────────────────────────────────────────────
OTP_LENGTH=6
OTP_EXPIRY_SECONDS=120
OTP_MAX_ATTEMPTS=5
OTP_COOLDOWN_SECONDS=60

# ── Celery ───────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Digital Cards Encryption ──────────────────────────────────────
DIGITAL_CARDS_ENCRYPTION_KEY="+/FM6K/Adu0hgLRbWnMdKcHjXmMp0b13UMpG2yMSEsE="
