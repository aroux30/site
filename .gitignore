# Environment & secrets — never commit a filled-in copy
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Node / Next.js
node_modules/
.next/
out/
*.tsbuildinfo

# Runtime state — uploads and backups must never enter the repo
/media/
/backend/media/
/backups/
/logs/
*.log

# Graphify outputs are build artifacts, regenerated by `graphify update`
/graphify-out/

# Components parked out of the build (see .audit-deleted-components.txt).
# Kept on disk because this repo has no version control: a deletion here is
# not recoverable from history.
/frontend/.deleted-components/

# Claude Code worktrees
.claude/worktrees/

# Editor / OS noise
.DS_Store
Thumbs.db
.idea/
.vscode/
