# ============================================
# E-Commerce Platform - Environment Variables
# ============================================
# Copy this file to .env and update values
# NEVER commit .env to version control
# ============================================

# ──────────────────────────────────────────
# General
# ──────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=debug
DOMAIN=localhost

# ──────────────────────────────────────────
# PostgreSQL
# ──────────────────────────────────────────
POSTGRES_DB=ecommerce
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=change_me_in_production
DATABASE_URL=postgresql+asyncpg://ecommerce:change_me_in_production@postgres:5432/ecommerce

# ──────────────────────────────────────────
# Redis
# ──────────────────────────────────────────
REDIS_PASSWORD=change_me_in_production
REDIS_URL=redis://:change_me_in_production@redis:6379/0
CELERY_BROKER_URL=redis://:change_me_in_production@redis:6379/1
CELERY_RESULT_BACKEND=redis://:change_me_in_production@redis:6379/2

# ──────────────────────────────────────────
# Elasticsearch
# ──────────────────────────────────────────
ELASTICSEARCH_URL=http://elasticsearch:9200
# Required in production (docker-compose.prod.yml enables xpack.security).
# Generate with: openssl rand -hex 32
ELASTICSEARCH_PASSWORD=change_me_in_production

# ──────────────────────────────────────────
# Security / Auth
# ──────────────────────────────────────────
JWT_SECRET_KEY=change_me_in_production_use_openssl_rand
JWT_ALGORITHM=HS256
# NOTE: the settings model reads ACCESS_TOKEN_EXPIRE_MINUTES /
# REFRESH_TOKEN_EXPIRE_DAYS (without the JWT_ prefix). The old JWT_-prefixed
# names here were silently ignored — setting them changed nothing.
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ──────────────────────────────────────────
# MinIO (S3-compatible Object Storage)
# ──────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET_NAME=ecommerce-media
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123

# ──────────────────────────────────────────
# Email (SMTP)
# ──────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=E-Commerce Platform
SMTP_TLS=true

# ──────────────────────────────────────────
# Stripe (Payments)
# ──────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ──────────────────────────────────────────
# Sentry (Error Tracking)
# ──────────────────────────────────────────
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ──────────────────────────────────────────
# Frontend (Next.js)
# ──────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost/api/v1
NEXT_PUBLIC_APP_NAME=E-Commerce Platform
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SENTRY_DSN=

# ──────────────────────────────────────────
# Backend Server
# ──────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_WORKERS=4
BACKEND_CORS_ORIGINS=["http://localhost","http://localhost:3000","http://localhost:80"]
BACKEND_ALLOWED_HOSTS=["*"]

# ──────────────────────────────────────────
# Rate Limiting
# ──────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# Number of TRUSTED reverse proxies between the internet and the backend.
# The code default is 1, which is WRONG for this stack: traffic crosses TWO
# proxies (host nginx that terminates TLS, then the container nginx), so
# X-Forwarded-For arrives as "<client>, <host-nginx>" and the real client is
# the SECOND hop from the right. With the default of 1 every request is keyed
# to the proxy's own address, collapsing all callers into one shared
# rate-limit bucket (an attacker could then exhaust the login limit for
# everyone). Set to 2 here; never raise it above the real proxy count — the
# extra hops to the left are client-supplied and spoofable.
TRUSTED_PROXY_COUNT=2

# Peer addresses uvicorn will trust for X-Forwarded-* headers
# (backend/scripts/start.sh). Defaults to 127.0.0.1 (loopback only) when
# unset, so a direct internet peer cannot spoof request.client. The backend's
# peer in this stack is the nginx container on the docker app-network, so a
# private-range CIDR is appropriate. Do NOT use '*'.
FORWARDED_ALLOW_IPS=172.16.0.0/12

# ──────────────────────────────────────────
# File Upload
# ──────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=50
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/gif

# ──────────────────────────────────────────
# Monitoring
# ──────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
PROMETHEUS_RETENTION_DAYS=15

# Value of the Prometheus external_labels.environment label. Read via the
# --enable-feature=expand-external-labels flag set in docker-compose.yml.
# Defaults to "production"; set to "staging" etc. per deployment.
PROMETHEUS_ENVIRONMENT=production

# Destination for Alertmanager notifications (REPLACE with a real endpoint).
# REQUIRED when the alertmanager service starts — it refuses to boot if unset,
# because the previous value (http://localhost:5001/..., served by nothing)
# silently swallowed every alert. Point it at something that accepts the
# Alertmanager webhook JSON (see monitoring/alertmanager/templates/
# iranian_ops.tmpl): an internal ops API, a Telegram/Slack bridge, or a small
# relay container you run yourself. No such endpoint ships in this repo.
ALERTMANAGER_WEBHOOK_URL=https://ops.example.com/hooks/alertmanager

# ──────────────────────────────────────────
# Feature Flags
# ──────────────────────────────────────────
ENABLE_REGISTRATION=true
ENABLE_SOCIAL_AUTH=false
ENABLE_ELASTICSEARCH=true
ENABLE_CELERY=true

# ─────────────────────────────────────────
# Backups (scripts/backup.sh, scripts/restore.sh)
# ─────────────────────────────────────────
# Passphrase for AES-256-CBC backup encryption. When set AND encryption is
# requested (--encrypt, or BACKUP_REQUIRE_ENCRYPTION=1 below), artifacts are
# encrypted at rest; restore.sh decrypts them with the same value. Generate a
# strong one: python -c "import secrets; print(secrets.token_urlsafe(48))".
# Leave empty to write UNENCRYPTED (still checksummed) backups.
BACKUP_ENCRYPTION_KEY=
# When 1, every backup MUST be encrypted and the run fails if the key above is
# missing — rather than silently writing plaintext. Recommended in production.
BACKUP_REQUIRE_ENCRYPTION=0

# ──────────────────────────────────────────
# API docs (disabled automatically in production)
# ──────────────────────────────────────────
# /docs, /redoc and /openapi.json are auto-disabled when ENVIRONMENT=production.
# Set true only to serve them deliberately behind an internal network.
ENABLE_API_DOCS=false

# ──────────────────────────────────────────
# Metrics (required in production)
# ──────────────────────────────────────────
# /metrics is reachable through nginx (/api/v1/metrics is under the proxied
# /api/ prefix) and its labels list every route path, including /admin/*.
# In production the endpoint requires this bearer token; the app refuses to
# boot without it (min 16 chars). Generate with: openssl rand -hex 32
# Configure Prometheus: authorization: { type: Bearer, credentials: <token> }
# In development/staging the endpoint stays open.
METRICS_TOKEN=change_me_in_production_use_openssl_rand

# ──────────────────────────────────────────
# CORS
# ──────────────────────────────────────────
# Comma-separated origins (a JSON array is also accepted). BACKEND_CORS_ORIGINS
# is honoured as a legacy alias, but prefer CORS_ORIGINS.
CORS_ORIGINS=http://localhost:3000,http://localhost

# ──────────────────────────────────────────
# Payment providers
# ──────────────────────────────────────────
# mock | zarinpal | idpay | crypto | card_transfer
PAYMENT_PROVIDER=mock
PAYMENT_MERCHANT_ID=
PAYMENT_SANDBOX=true
PAYMENT_CALLBACK_BASE_URL=http://localhost:3000/payment/callback

# NowPayments (crypto: USDT/BTC/ETH). NOWPAYMENTS_IPN_SECRET verifies the
# server-to-server callback and is enforced fail-closed.
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_SANDBOX=true
# Rial per USD used to quote crypto amounts. Integer; never a float.
NOWPAYMENTS_IRR_PER_USD=600000

# Card-to-card (manual bank transfer) details shown at checkout.
CARD_TO_CARD_NUMBER=
CARD_TO_CARD_HOLDER=
CARD_TO_CARD_BANK=

# Minimum wallet top-up, integer Rial.
WALLET_TOPUP_MIN_IRIALS=100000

# ──────────────────────────────────────────
# SMS provider
# ──────────────────────────────────────────
# mock | kavenegar | ghasedak. 'mock' logs instead of sending.
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_SENDER_NUMBER=

# ──────────────────────────────────────────
# Telegram bot (notifications)
# ──────────────────────────────────────────
# Delivery is DISABLED while TELEGRAM_BOT_TOKEN is blank.
TELEGRAM_BOT_TOKEN=

# ──────────────────────────────────────────
# Web push (VAPID)
# ──────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ──────────────────────────────────────────
# Google SSO (optional)
# ──────────────────────────────────────────
# All three blank = SSO login disabled. The callback endpoint answers
# SSO_NOT_CONFIGURED rather than failing mid-flow.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# ──────────────────────────────────────────
# Identity verification (Karta Zohal: Shahkar / civil registry)
# ──────────────────────────────────────────
# Without a token the KYC endpoints report UNAVAILABLE — trust is never
# granted from unverified input.
IDENTITY_PROVIDER_TOKEN=

# ──────────────────────────────────────────
# Digital goods encryption (AES-256-GCM key for digital card PINs)
# ──────────────────────────────────────────
# Base64-encoded 32-byte key. Generate:
#   python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
DIGITAL_CARDS_ENCRYPTION_KEY=

# ──────────────────────────────────────────
# Initial admin account (seeded on first boot)
# ──────────────────────────────────────────
ADMIN_PHONE=
ADMIN_PASSWORD=

# ──────────────────────────────────────────
# OpenTelemetry tracing
# ──────────────────────────────────────────
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ──────────────────────────────────────────
# SMTP username (SMTP_HOST/PORT/PASSWORD are above)
# ──────────────────────────────────────────
SMTP_USERNAME=

# Instructions shown to the customer on the card-to-card payment page.
CARD_TO_CARD_INSTRUCTIONS=لطفاً مبلغ را به شماره کارت زیر واریز نموده و سپس شماره پیگیری / شماره ارجاع را در بخش ثبت فیش ارسال فرمایید. پس از بررسی و تأیید مدیریت، سفارش شما تکمیل خواهد شد.
