# ==============================================================================
# Iranian E-Commerce Platform – Environment Variables
# ==============================================================================
# Copy this file to `.env` and fill in production values.
# DO NOT commit the `.env` file to version control.
# ==============================================================================

# ── Application ──────────────────────────────────────────────────────────
APP_NAME="Iranian E-Commerce"
ENVIRONMENT=development          # development | staging | production
DEBUG=true
LOG_LEVEL=INFO

# ── Database (PostgreSQL) ────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ecommerce
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_ECHO=false

# ── Redis ────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=ecom:
REDIS_DEFAULT_TTL=300

# ── Elasticsearch ────────────────────────────────────────────────────────
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX_PREFIX=ecom_

# ── JWT / Authentication ─────────────────────────────────────────────────
JWT_SECRET_KEY=CHANGE-ME-use-openssl-rand-hex-64
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Bootstrap administrator password. Production startup refuses to boot when
# this is empty or shorter than 12 characters, so it must be set deliberately
# rather than left to a default.
ADMIN_PASSWORD=

# Credential for the Iranian identity / mobile-ownership inquiry provider
# (Zohal/Shahkar shape). When empty the capability is reported as
# not-configured and the inquiry fails closed instead of returning a
# fabricated verification.
IDENTITY_PROVIDER_TOKEN=

# ── CORS ─────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Sentry ───────────────────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ── OpenTelemetry & Observability ─────────────────────────────────────
OTEL_ENABLED=true
OTEL_SERVICE_NAME=iranian-ecommerce-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_TRACES_SAMPLER_RATIO=1.0
DATABASE_SLOW_QUERY_THRESHOLD_MS=100.0
REDIS_SLOW_OPERATION_THRESHOLD_MS=20.0
API_SLOW_REQUEST_THRESHOLD_MS=700.0
API_CRITICAL_REQUEST_THRESHOLD_MS=1400.0
OBSERVABILITY_DEBUG=false

# ── Trusted proxy / client IP ─────────────────────────────────────────────
# Number of TRUSTED reverse proxies in front of the app. The code default of
# 1 assumes a single nginx, but this stack has TWO (host nginx terminating
# TLS -> container nginx -> backend), so X-Forwarded-For is
# "<client>, <host-nginx>" and the client is the 2nd hop from the right.
# With 1, every request keys to the proxy address and all callers share one
# rate-limit bucket. Set 2; never exceed the real proxy count.
TRUSTED_PROXY_COUNT=2

# Peer addresses uvicorn trusts for X-Forwarded-* (backend/scripts/start.sh).
# Unset => 127.0.0.1 (loopback only). The backend's peer is the nginx
# container on the docker app-network; a private CIDR is appropriate.
# Do NOT use '*'.
FORWARDED_ALLOW_IPS=172.16.0.0/12

# ── MinIO / S3-compatible storage ────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=ecommerce
MINIO_USE_SSL=false
MINIO_REGION=us-east-1

# ── SMS Provider ─────────────────────────────────────────────────────────
SMS_PROVIDER=mock                # kavenegar | ghasedak | mock
SMS_API_KEY=
SMS_SENDER_NUMBER=

# ── Email (SMTP) Provider ────────────────────────────────────────────────
# Leave SMTP_HOST blank to keep email in log-only mock mode (development).
# Port 465 = implicit SSL; 587 = STARTTLS (SMTP_USE_TLS=true); 25 = plain relay.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=فروشگاه اینترنتی
SMTP_TIMEOUT_SECONDS=15

# ── Telegram Bot Provider ────────────────────────────────────────────────
# Leave TELEGRAM_BOT_TOKEN blank to keep Telegram in log-only mock mode
# (development). Token comes from @BotFather; username feeds the account
# page's deep-link hint (https://t.me/<username>).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_TIMEOUT_SECONDS=15

# ── Web Push (VAPID) ──────────────────────────────────────────────────────
# Browser push needs the pywebpush package (currently NOT installed — see
# notifications/application/push_service.py). Keys are readied here so the
# provider flips live the moment package + keys are both present.
# Generate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@site.com
PUSH_TIMEOUT_SECONDS=15

# ── Payment Provider ────────────────────────────────────────────────────
PAYMENT_PROVIDER=mock            # zarinpal | idpay | mock | crypto | card_transfer
PAYMENT_MERCHANT_ID=
PAYMENT_CALLBACK_BASE_URL=http://localhost:3000/payment/callback
PAYMENT_SANDBOX=true
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_SANDBOX=true
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_IRR_PER_USD=600000
CARD_TO_CARD_NUMBER=6219-8610-1234-5678
CARD_TO_CARD_HOLDER=فروشگاه آنلاین
CARD_TO_CARD_BANK=بانک سامان

# ── OTP ──────────────────────────────────────────────────────────────────
OTP_LENGTH=6
OTP_EXPIRY_SECONDS=120
OTP_MAX_ATTEMPTS=5
OTP_COOLDOWN_SECONDS=60

# ── Celery ───────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Digital Cards Encryption ──────────────────────────────────────
# Generate with: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
DIGITAL_CARDS_ENCRYPTION_KEY="CHANGE-ME-generate-a-unique-base64-32byte-key"

# ── HTTP Cache (ETag / optional page cache) ──────────────────────────────
# ETag/304 negotiation for anonymous API GETs is always active. The Redis
# full-response page cache is opt-in: when true, repeat anonymous GETs under
# PAGE_CACHE_PATH_PREFIXES are served from Redis for PAGE_CACHE_TTL_SECONDS.
# Public read-only prefixes only — credentials, Set-Cookie, and no-store
# responses are never cached (see app/core/http_cache.py).
PAGE_CACHE_ENABLED=false
PAGE_CACHE_PATH_PREFIXES=/api/v1/settings/public,/api/v1/blog,/api/v1/content
PAGE_CACHE_TTL_SECONDS=60
