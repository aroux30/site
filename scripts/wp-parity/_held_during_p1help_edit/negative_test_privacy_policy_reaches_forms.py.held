"""Negative test: the privacy-policy reachability guard can actually fail.

A source-reading guard is the shape most likely to be decorative, and this one
has an unusual amount to be decorative about: five files, four of them on the
frontend, none of it executed. So each link in the chain is broken in turn.

The two cases worth the trouble:

  - an import with no render. The registration form keeps
    `import { PrivacyClause }` while the call site is deleted — so the file still
    contains the words a name-based guard looks for, and a visitor sees no link.
    This is the shipped-but-dead half, and it is invisible to tsc, to lint and
    to import graphs.
  - an unconditional render. Every chain link is present and the guard is happy,
    while a store with no published policy gets a link that 404s on submit.

    python scripts/wp-parity/negative_test_privacy_policy_reaches_forms.py
"""

from __future__ import annotations

import io
import os
import subprocess
import sys
from pathlib import Path

sys.stdout = io.TextIOWrapper(sys.stdout.buffer, encoding="utf-8", errors="replace")

ROOT = Path(__file__).resolve().parents[2]
GUARD = ROOT / "scripts" / "wp-parity" / "check_privacy_policy_reaches_forms.py"

DEFAULTS = ROOT / "backend/app/modules/settings/application/default_options.py"
SERVICE = ROOT / "backend/app/modules/settings/application/privacy_policy_service.py"
ROUTES = ROOT / "backend/app/modules/settings/api/routes.py"
CLIENT = ROOT / "frontend/lib/api/settings.ts"
NOTICE = ROOT / "frontend/components/privacy/privacy-policy-notice.tsx"
REGISTER = ROOT / "frontend/app/(store)/register/page.tsx"
COMMENTS = ROOT / "frontend/components/blog/blog-comments.tsx"

#: The whole route, decorator through body. Moving *this* below the catch-all is
#: the realistic mistake: the feature works, the endpoint exists, every unit test
#: of the service passes, and the storefront gets a 404 that is indistinguishable
#: from a store with no policy.
ROUTE_BLOCK = '''@router.get(
    "/public/privacy-policy",
    response_model=PrivacyPolicyResponse,
    summary="The published privacy policy page",
)
async def get_privacy_policy(
    db: AsyncSession = Depends(get_db),
) -> PrivacyPolicyResponse:
    """Return the privacy policy page, or empty fields when none is published.

    Public and unauthenticated on purpose: this is called from the registration,
    comment and checkout forms, before anyone has an account. It carries no
    personal data — a title and a URL — so there is nothing to protect here.

    Declared above ``/{key}`` deliberately. FastAPI matches in declaration order,
    so a route registered after it would be captured as a setting named
    "privacy-policy" and return 404 for every caller, which reads as "this store
    has no privacy policy" on a store that has one.
    """
    policy = await PrivacyPolicyService.get_policy(db)
    if policy is None:
        return PrivacyPolicyResponse()
    return PrivacyPolicyResponse(**policy)


'''

# (name, file, original, broken, expected substring in the guard's output)
CASES: list[tuple[str, Path, str, str, str]] = [
    (
        "the setting is not seeded",
        DEFAULTS,
        '"privacy.policy_page": "",',
        '"privacy.policy_slug": "",',
        "no privacy.policy_page option is seeded",
    ),
    (
        # Renamed, not moved. This is not a stand-in for the ordering case — it
        # is the ordering case's prerequisite. A guard that reads declaration
        # order out of the source text can only ever be told "this path appears
        # before that one", and a path that appears nowhere passes. Renaming
        # first proves the route really disappeared; moving it is proved by
        # check_privacy_policy_reaches_forms.py reading the app's own route table,
        # which is the only place the order actually lives.
        "the endpoint disappears",
        ROUTES,
        '@router.get(\n    "/public/privacy-policy",',
        '@router.get(\n    "/public/privacy-policy-x",',
        "no /settings/public/privacy-policy route",
    ),
    (
        "a draft can be served as the policy",
        SERVICE,
        "        if page.status != PageStatus.PUBLISHED:",
        "        if False:",
        "does not require the policy page to be published",
    ),
    (
        "a hidden page can be served as the policy",
        SERVICE,
        "        if page.visibility != PageVisibility.PUBLIC:",
        "        if False:",
        "does not require the policy page to be public",
    ),
    (
        "the frontend client stops reading the endpoint",
        CLIENT,
        '"/settings/public/privacy-policy",',
        '"/settings/public/privacy-policy-v2",',
        "never issues the request for",
    ),
    (
        "the notice renders whether or not a policy exists",
        NOTICE,
        "  if (!policy.url || !policy.title) return null;",
        "  if (false) return null;",
        "renders its link unconditionally",
    ),
    (
        "the comment form stops mentioning it",
        COMMENTS,
        '<PrivacyPolicyNotice className="text-xs leading-relaxed text-muted-foreground" />',
        "",
        "imports the notice but never renders it",
    ),
    (
        "the register form keeps the import but drops the render",
        REGISTER,
        "                    <PrivacyClause />\n",
        "",
        "imports the notice but never renders it",
    ),
]


def run_guard() -> tuple[int, str]:
    # A subprocess, not an import: this script and the guard both rebind
    # sys.stdout to a fresh TextIOWrapper at import time, and the two wrappers
    # share a buffer, so importing the guard closes the stream this script is
    # still printing to.
    proc = subprocess.run(
        [sys.executable, str(GUARD)],
        capture_output=True,
        text=True,
        encoding="utf-8",
        errors="replace",
        cwd=ROOT,
        env={**os.environ, "PYTHONIOENCODING": "utf-8"},
    )
    return proc.returncode, proc.stdout + proc.stderr


def main() -> int:
    saved: dict[Path, str] = {}
    for _, path, _, _, _ in CASES:
        if path not in saved:
            saved[path] = path.read_text(encoding="utf-8")

    print("baseline (unbroken tree):")
    code, out = run_guard()
    if code != 0:
        print(out)
        print(
            "FAIL: the guard is not green on the unbroken tree, so a red run below "
            "would mean nothing"
        )
        return 1
    print("  PASS as expected")
    print("")

    failures: list[str] = []
    for name, path, original, broken, expected in CASES:
        source = saved[path]
        if original not in source:
            failures.append(
                "%s: the marker to break is not in %s, so this case would prove "
                "nothing -- update it for the current source" % (name, path.name)
            )
            continue
        path.write_text(source.replace(original, broken, 1), encoding="utf-8")
        try:
            code, out = run_guard()
        finally:
            path.write_text(source, encoding="utf-8")

        if code == 0:
            failures.append("%s: the guard still passed" % name)
            print("  FAIL %s -- the guard still passed" % name)
        elif expected not in out:
            failures.append(
                "%s: the guard went red, but not for this reason -- expected %r in "
                "the output" % (name, expected)
            )
            print("  FAIL %s -- red for the wrong reason" % name)
            print("    " + out.strip().replace("\n", "\n    "))
        else:
            print("  PASS %s -> guard went red for the right reason" % name)

    code, out = run_guard()
    if code != 0:
        print(out)
        failures.append("the guard is red again after restoring every file")
    else:
        print("")
        print("PASS: the tree is green again after every injection was reverted.")

    if failures:
        print("")
        for f in failures:
            print("FAIL: %s" % f)
        return 1
    print("")
    print("PASS: every link in this chain can break, and the guard notices each one.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
