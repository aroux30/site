<!-- Wazuh SIEM Detection Rules for FastAPI Security Audit Logs -->
<group name="fastapi,security,">

  <rule id="100100" level="3">
    <match>[SECURITY_ALERT]</match>
    <description>FastAPI Security Event Detected</description>
  </rule>

  <rule id="100101" level="6">
    <if_sid>100100</if_sid>
    <match>event=auth_failed_attempt</match>
    <description>FastAPI: Authentication failure attempt</description>
    <group>authentication_failed,</group>
  </rule>

  <rule id="100102" level="10">
    <if_sid>100100</if_sid>
    <match>event=brute_force_lockout</match>
    <description>FastAPI: Account locked due to repeated brute-force attacks</description>
    <mitre>
      <id>T1110.001</id>
    </mitre>
    <group>brute_force,attack,</group>
  </rule>

  <rule id="100103" level="8">
    <if_sid>100100</if_sid>
    <match>event=bot_honeypot_triggered</match>
    <description>FastAPI: Automated bot crawler detected and trapped via honeypot</description>
    <mitre>
      <id>T1595</id>
    </mitre>
    <group>reconnaissance,bot,</group>
  </rule>

  <rule id="100104" level="7">
    <if_sid>100100</if_sid>
    <match>event=rate_limit_exceeded</match>
    <description>FastAPI: Rate limit threshold exceeded</description>
    <group>rate_abuse,</group>
  </rule>

</group>
