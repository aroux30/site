# ============================================
# E-Commerce Platform - Environment Variables
# ============================================
# Copy this file to .env and update values
# NEVER commit .env to version control
# ============================================

# ──────────────────────────────────────────
# General
# ──────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=debug
DOMAIN=localhost

# ──────────────────────────────────────────
# PostgreSQL
# ──────────────────────────────────────────
POSTGRES_DB=ecommerce
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=change_me_in_production
DATABASE_URL=postgresql+asyncpg://ecommerce:change_me_in_production@postgres:5432/ecommerce

# ──────────────────────────────────────────
# Redis
# ──────────────────────────────────────────
REDIS_PASSWORD=change_me_in_production
REDIS_URL=redis://:change_me_in_production@redis:6379/0
CELERY_BROKER_URL=redis://:change_me_in_production@redis:6379/1
CELERY_RESULT_BACKEND=redis://:change_me_in_production@redis:6379/2

# ──────────────────────────────────────────
# Elasticsearch
# ──────────────────────────────────────────
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_PASSWORD=

# ──────────────────────────────────────────
# Security / Auth
# ──────────────────────────────────────────
JWT_SECRET_KEY=change_me_in_production_use_openssl_rand
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ──────────────────────────────────────────
# MinIO (S3-compatible Object Storage)
# ──────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET_NAME=ecommerce-media
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123

# ──────────────────────────────────────────
# Email (SMTP)
# ──────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=E-Commerce Platform
SMTP_TLS=true

# ──────────────────────────────────────────
# Stripe (Payments)
# ──────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ──────────────────────────────────────────
# Sentry (Error Tracking)
# ──────────────────────────────────────────
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ──────────────────────────────────────────
# Frontend (Next.js)
# ──────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost/api/v1
NEXT_PUBLIC_APP_NAME=E-Commerce Platform
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SENTRY_DSN=

# ──────────────────────────────────────────
# Backend Server
# ──────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_WORKERS=4
BACKEND_CORS_ORIGINS=["http://localhost","http://localhost:3000","http://localhost:80"]
BACKEND_ALLOWED_HOSTS=["*"]

# ──────────────────────────────────────────
# Rate Limiting
# ──────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# ──────────────────────────────────────────
# File Upload
# ──────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=50
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/gif

# ──────────────────────────────────────────
# Monitoring
# ──────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
PROMETHEUS_RETENTION_DAYS=15

# ──────────────────────────────────────────
# Feature Flags
# ──────────────────────────────────────────
ENABLE_REGISTRATION=true
ENABLE_SOCIAL_AUTH=false
ENABLE_ELASTICSEARCH=true
ENABLE_CELERY=true
